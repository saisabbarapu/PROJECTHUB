# Server Port
PORT=4000

# MongoDB Connection String (Local or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/project-showcase
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/project-showcase?retryWrites=true&w=majority
MONGODB_URL=mongodb://127.0.0.1:27017/project-showcase

# Allowed Frontend URLs for CORS (comma-separated for multiple)
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Nodemailer / Gmail SMTP Configuration (Optional)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
